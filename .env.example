# Copy this file to .env and fill in every value. Never commit .env.
# Generate keys with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=3000
# The public HTTPS address of this server. Twilio signs requests against it.
PUBLIC_BASE_URL=http://localhost:3000
# SQLite file for screenings and referrals. Back it up; it holds encrypted phone numbers.
DATABASE_PATH=./data/dada.db

# 32 random bytes, base64. Encrypts callback phone numbers. Losing it makes them unreadable.
ENCRYPTION_KEY=
# 32 or more random bytes, base64. Keys WhatsApp conversations without storing numbers.
HASH_KEY=

# Long random string. Add it to the Africa's Talking callback URL as ?key=...
USSD_CALLBACK_KEY=
# From the Twilio console. Required when NODE_ENV=production.
TWILIO_AUTH_TOKEN=

# Login for the staff referral queue at /staff. Use a password of 12+ characters.
STAFF_USER=counsellor
STAFF_PASSWORD=

# Areas offered for follow-up, comma separated, in the order shown on the phone.
WARDS=Kangemi,Dagoretti

# EPDS cut-offs, set by the clinical lead.
EPDS_POSSIBLE=10
EPDS_PROBABLE=13

# Conversations are forgotten after this many minutes of silence.
SESSION_TTL_MINUTES=30
# Contacted referrals are deleted after this many days.
RETENTION_DAYS=90
# Public counts below this number are hidden.
STATS_SUPPRESSION=5

# Optional. An OpenAI-compatible endpoint (for example a self-hosted model) used only when the
# built-in rules cannot understand a free-text WhatsApp answer. Leave empty to turn off.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=4000

# Optional. Incoming webhook (Slack, Teams, Google Chat) told about new referrals. No phone numbers are sent.
REFERRAL_WEBHOOK_URL=
