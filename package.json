{
  "name": "dada",
  "version": "0.1.0",
  "description": "Open-source perinatal mental health and safety screening over USSD and WhatsApp, in Sheng, Swahili and English, with referral to community health promoters and counsellors.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "simulate": "node --env-file-if-exists=.env scripts/simulate-ussd.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
